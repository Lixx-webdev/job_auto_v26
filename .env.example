# =============================================================================
# Job Automation Platform — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — the app will refuse to start without these
# -----------------------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat / channel ID where notifications are sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# LinkedIn integration (optional — leave blank to disable)
# -----------------------------------------------------------------------------

LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# -----------------------------------------------------------------------------
# Gmail integration (optional — leave blank to disable)
# Use an App Password, not your main account password.
# https://support.google.com/accounts/answer/185833
# -----------------------------------------------------------------------------

GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# -----------------------------------------------------------------------------
# AI & scraping tuning
# -----------------------------------------------------------------------------

# Minimum AI match score (0-100) to consider a job worth applying to
AI_MATCH_THRESHOLD=70

# How often (in hours) to re-scrape job boards
SCRAPE_INTERVAL_HOURS=4

# Maximum number of jobs to process per scraping run
MAX_JOBS_PER_RUN=30

# Comma-separated list of target locations
TARGET_LOCATIONS=India,Remote,Bengaluru,Hyderabad,Mumbai,Pune,Chennai,Delhi

# Comma-separated list of target seniority levels
TARGET_SENIORITY=mid,senior

# Comma-separated job-title search keywords
TARGET_KEYWORDS=security engineer,data scientist,software engineer,ML engineer,fintech

# Only consider jobs posted within this many days
MAX_JOB_AGE_DAYS=7

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy database URL.
# SQLite (default, file-based, no extra setup):
DB_URL=sqlite:///./job_automation.db
# PostgreSQL example:
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/job_automation

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
